# DevX POS — environment configuration (example)
# Copy to ".env" and fill in real values. NEVER commit a real .env.

# MySQL connection string used by Prisma.
DATABASE_URL="mysql://user:password@localhost:3306/devx_pos"

# REQUIRED in production. Secret used to sign session JWTs.
# - Must be a long, random, private value (32+ characters).
# - If it is missing in production, the API refuses to sign/verify
#   tokens (fails securely) rather than using any built-in fallback.
# - ROTATION: changing this value invalidates every existing session
#   token — all users will need to log in again. Rotate immediately
#   if a secret was ever committed to source control.
JWT_SECRET=""

# Seed-only credentials (prisma/seed.js). The seed refuses to run
# without them — there are no default seeded passwords anymore.
SEED_ADMIN_PASSWORD=""
SEED_CASHIER_PASSWORD=""

# Optional. Directory for NEW uploaded images (POST /api/uploads,
# Phase 5 section 5.3). Default: <project>/public/uploads, served at
# /uploads/<file>. If you point this elsewhere, that directory must
# be exposed at /uploads/ by your web server. NOTE: local disk is
# not persistent on serverless/ephemeral hosts — use object storage
# (S3/Cloudinary) there instead (not yet implemented).
# UPLOAD_DIR=""

# Courier integrations (Phase 4, D4/D5) — OPTIONAL, server-side only.
# Credentials are read from these variables by src/lib/courier and
# are NEVER exposed to the browser: the admin Settings → System
# "Courier Providers" card shows only whether each provider is
# configured and which of these NAMES are still missing.
# Live booking stays disabled until the credentials exist AND the
# provider contracts are verified from the merchant panels (D5).
# Leave unset to keep a provider unconfigured.
#
# Steadfast (static Api-Key / Secret-Key headers):
# STEADFAST_API_KEY=""
# STEADFAST_SECRET_KEY=""
# Optional base-URL override (default: https://portal.packzy.com/api/v1):
# STEADFAST_BASE_URL=""
#
# Pathao (OAuth 2.0 — merchant account username/password + app
# credentials + the approved store id bookings are made against):
# PATHAO_CLIENT_ID=""
# PATHAO_CLIENT_SECRET=""
# PATHAO_USERNAME=""
# PATHAO_PASSWORD=""
# PATHAO_STORE_ID=""
# Optional base-URL override (default: https://api-hermes.pathao.com;
# sandbox: https://courier-api-sandbox.pathao.com):
# PATHAO_BASE_URL=""
