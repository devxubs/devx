# DevX POS — environment configuration (example)
# Copy to ".env" and fill in real values. NEVER commit a real .env.

# MySQL connection string used by Prisma.
DATABASE_URL="mysql://user:password@localhost:3306/devx_pos"

# REQUIRED in production. Secret used to sign session JWTs.
# - Must be a long, random, private value (32+ characters).
# - If it is missing in production, the API refuses to sign/verify
#   tokens (fails securely) rather than using any built-in fallback.
# - ROTATION: changing this value invalidates every existing session
#   token — all users will need to log in again. Rotate immediately
#   if a secret was ever committed to source control.
JWT_SECRET=""

# Seed-only credentials (prisma/seed.js). The seed refuses to run
# without them — there are no default seeded passwords anymore.
SEED_ADMIN_PASSWORD=""
SEED_CASHIER_PASSWORD=""
